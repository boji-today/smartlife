# tinytuya wizard
# .venv/bin/python -m tinytuya wizard -nocolor -yes -key "$TUYA_API_KEY" -secret "$TUYA_API_SECRET" -region "$TUYA_API_REGION" -device "$TUYA_DEVICE_ID"
TUYA_API_KEY=
TUYA_API_SECRET=
# cn | us | us-e | eu | eu-w | in | sg
TUYA_API_REGION=
# 已在 Smart Life / Tuya App 注册的任意 Device ID，或 scan
TUYA_DEVICE_ID=
# 五段 crontab，准点采集
COLLECT_CRON='*/5 * * * *'
# 1 则进程启动时额外采集一次
COLLECT_ON_BOOT=1
# Infinity HTTP 端口
HTTP_PORT=8080
